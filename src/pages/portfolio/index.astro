---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { Image } from 'astro:assets';
import allWork from '../../content/work-overview.json';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const logoNames: Record<string, string> = {
  vio: 'Vio',
  dyson: 'Dyson',
  citizenm: 'citizenM',
  'nr-magazine': 'NR Magazine',
  otrium: 'Otrium',
};

const logoAssets: Record<string, { src: string; alt: string }> = {
  vio: { src: '/logos/vio.svg', alt: 'Vio.com' },
  dyson: { src: '/logos/dyson.svg', alt: 'Dyson' },
  citizenm: { src: '/logos/citizenm.png', alt: 'citizenM' },
  'nr-magazine': { src: '/logos/nr-magazine-cover.jpg', alt: 'NR Magazine' },
  otrium: { src: '/logos/otrium.svg', alt: 'Otrium' },
};
const previews: Record<string, string> = {
  vio: '/videos/vio/logo-animation.mp4',
  dyson: '/videos/dyson/dyson-portfolio-loop.mp4',
  citizenm: '/videos/citizenm/rome-artist-files.mp4',
};

// Include the full asset collection, interleaved across clients.
const assets = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  ['../../assets/projects/**/*.{jpg,jpeg,png,webp}', '../../../public/images/**/*.{jpg,jpeg,png,webp}'],
  { eager: true },
);
const overview = allWork.map((item) => ({
  ...item,
  image: item.video ? undefined : assets[item.src.startsWith('/images/')
    ? `../../../public${item.src}` : item.src].default,
}));

const topRowSources = [
  '/images/citizenm/rome/towel.webp',
  '/videos/dyson/dyson-airstrait-hero-clean.mp4',
  '/videos/citizenm/rome-artist-files.mp4',
  '/images/citizenm/rome/windows.jpg',
];
const topRow = topRowSources.map((src) => overview.find((item) => item.src === src)!);
const featuredCover = '/images/nr-magazine/02-NR17-Cover-VTSS-shot-by-Erika-Kamano-min-scaled.jpg';
const remainingWork = overview.filter((item) => !topRowSources.includes(item.src));
const orderedWork = [
  ...topRow,
  ...remainingWork.filter((item) => item.src === featuredCover),
  ...remainingWork.filter((item) => item.src !== featuredCover),
];

---

<Base title="Portfolio" description="Selected copywriting, creative direction and editorial work.">
  <SiteHeader linkHome />

  <div class="work-views" aria-label="Work views" hidden>
    <button type="button" aria-pressed="true" aria-controls="work-overview" data-work-view="overview">Overview</button>
    <button type="button" aria-pressed="false" aria-controls="work-projects" data-work-view="projects">Projects</button>
  </div>

  <div id="work-overview" class="work-overview" aria-label="Selected work overview">
    {orderedWork.map((item) => (
      <a href={`/portfolio/${item.id}`} class="work-overview__item" aria-label={`${item.alt} — view ${logoNames[item.id]} project`}>
        {item.video ? (
          <video muted loop playsinline preload="metadata" aria-label={item.alt} data-overview-video>
            <source src={item.src} type={item.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'} />
          </video>
        ) : (
          <Image src={item.image!} alt={item.alt} widths={[400, 700, 1000]} sizes="(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 25vw" loading="lazy" />
        )}
        <span class="work-overview__caption" aria-hidden="true">{logoNames[item.id]} ↗</span>
      </a>
    ))}
  </div>

  <ul id="work-projects" class="portfolio-logo-grid" aria-label="Portfolio case studies">
    {
      projects.map((project) => (
        <li>
          <a
            href={`/portfolio/${project.id}`}
            class:list={['portfolio-logo', `portfolio-logo--${project.id}`]}
            aria-label={`${logoNames[project.id] ?? project.data.title} case study`}
          >
            <span class="portfolio-logo__mark">
              {previews[project.id] ? (
                <video autoplay muted loop playsinline preload="metadata" aria-hidden="true">
                  <source src={previews[project.id]} />
                </video>
              ) : (
                <Image src={project.data.cover} alt={project.data.coverAlt ?? project.data.title} width={1200} />
              )}
            </span>
            <span class="project-card-caption"><span>{logoNames[project.id] ?? project.data.title}</span><span>{project.data.role}</span></span>
          </a>
        </li>
      ))
    }
  </ul>

</Base>

<script>
  // Load and play only nearby films in the larger collection.
  const filmObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const video = entry.target as HTMLVideoElement;
      if (entry.isIntersecting) video.play().catch(() => undefined);
      else video.pause();
    });
  }, { rootMargin: '200px' });
  document.querySelectorAll('[data-overview-video]').forEach((video) => filmObserver.observe(video));
  const controls = document.querySelector<HTMLElement>('.work-views');
  const overviewPanel = document.querySelector<HTMLElement>('#work-overview');
  if (overviewPanel && 'ResizeObserver' in window) {
    const tiles = overviewPanel.querySelectorAll<HTMLElement>('.work-overview__item');
    const resizeTiles = new ResizeObserver((entries) => {
      if (overviewPanel.hidden) return;
      const styles = getComputedStyle(overviewPanel);
      const gap = parseFloat(styles.columnGap);
      const rowHeight = parseFloat(styles.gridAutoRows);
      for (const { target, borderBoxSize } of entries) {
        const tile = target as HTMLElement;
        const height = borderBoxSize[0].blockSize;
        tile.style.gridRowEnd = `span ${Math.ceil((height + gap) / rowHeight)}`;
      }
    });
    overviewPanel.classList.add('is-masonry');
    tiles.forEach((tile) => resizeTiles.observe(tile));
  }
  const projectsPanel = document.querySelector<HTMLElement>('#work-projects');
  if (controls && overviewPanel && projectsPanel) {
    controls.hidden = false;
    projectsPanel.hidden = true;
    controls.querySelectorAll<HTMLButtonElement>('button').forEach((button) => {
      button.addEventListener('click', () => {
        const showOverview = button.dataset.workView === 'overview';
        overviewPanel.hidden = !showOverview;
        projectsPanel.hidden = showOverview;
        controls.querySelectorAll('button').forEach((control) => {
          control.setAttribute('aria-pressed', String(control === button));
        });
      });
    });
  }
</script>

<style>
  [hidden] { display: none !important; }
  .work-views { display: flex; justify-content: center; gap: 1.5rem; margin-top: 2.5rem; }
  .work-views button { font: inherit; color: var(--color-ink); background: none; border: 0; padding: .25rem 0; cursor: pointer; border-bottom: .08rem solid transparent; }
  .work-views button[aria-pressed="true"] { color: var(--color-pink); border-bottom-color: currentColor; }
  .work-views button:focus-visible, .work-overview__item:focus-visible { outline: .1rem solid var(--color-pink); outline-offset: .3rem; }
  .work-overview, .portfolio-logo-grid { margin-top: 3rem; }
  .work-overview { columns: 4; column-gap: 1.25rem; }
  .work-overview.is-masonry {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 4px;
    grid-auto-flow: dense;
    align-items: start;
  }
  .work-overview.is-masonry .work-overview__item { margin-bottom: 0; }
  .work-overview__item { display: block; break-inside: avoid; position: relative; margin-bottom: 1.25rem; text-decoration: none; }
  .work-overview__item img, .work-overview__item video { display: block; width: 100%; height: auto; }
  .work-overview__caption { position: absolute; bottom: .65rem; left: .65rem; padding: .25rem .65rem; background: var(--color-paper, white); color: var(--color-ink); font-size: .85em; opacity: 0; transition: opacity 180ms ease; }
  .work-overview__item:hover .work-overview__caption, .work-overview__item:focus-visible .work-overview__caption { opacity: 1; }
  @media (max-width: 1100px) {
    .work-overview { columns: 2; }
    .work-overview.is-masonry { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .work-overview, .portfolio-logo-grid { margin-top: 2rem; }
    .work-overview { columns: 1; }
    .work-overview.is-masonry { grid-template-columns: minmax(0, 1fr); }
  }

  .portfolio-logo-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(4rem, 9vw, 9rem) 3rem;
  }

  .portfolio-logo-grid li {
    grid-column: span 2;
  }

  .portfolio-logo-grid li:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .portfolio-logo-grid li:nth-child(5) {
    grid-column: 4 / span 2;
  }

  .portfolio-logo {
    display: flex;
    min-height: clamp(7rem, 12vw, 12rem);
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    text-align: center;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .portfolio-logo:hover,
  .portfolio-logo:focus-visible {
    color: var(--color-pink);
    transform: scale(1.04);
  }

  .portfolio-logo:focus-visible {
    outline: 2px solid var(--color-pink);
    outline-offset: 0.5rem;
  }

  .portfolio-logo__mark {
    display: block;
    width: min(100%, 15rem);
  }

  .portfolio-logo__mark img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 5.5rem;
    object-fit: contain;
    filter: grayscale(1) brightness(0);
  }

  .portfolio-logo--vio .portfolio-logo__mark {
    width: min(100%, 14rem);
  }

  .portfolio-logo--dyson .portfolio-logo__mark {
    width: min(100%, 14rem);
  }

  .portfolio-logo--citizenm .portfolio-logo__mark {
    width: min(100%, 11rem);
  }

  .portfolio-logo--citizenm .portfolio-logo__mark img {
    max-height: 5.5rem;
  }

  .portfolio-logo--nr-magazine .portfolio-logo__mark {
    width: min(100%, 15rem);
    aspect-ratio: 4 / 1;
    overflow: hidden;
  }

  .portfolio-logo--nr-magazine .portfolio-logo__mark img {
    height: auto;
    max-height: none;
    object-fit: initial;
    filter: grayscale(1) brightness(2) contrast(3) invert(1);
  }

  .portfolio-logo--otrium .portfolio-logo__mark {
    width: min(100%, 15rem);
  }

  @media (max-width: 767px) {
    .portfolio-logo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem 1.5rem;
    }

    .portfolio-logo-grid li,
    .portfolio-logo-grid li:nth-child(4),
    .portfolio-logo-grid li:nth-child(5) {
      grid-column: span 1;
    }

    .portfolio-logo {
      min-height: 6rem;
    }
  }
  .portfolio-logo-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4rem 2rem;
  }
  .portfolio-logo-grid li:nth-child(n) { grid-column: auto; }
  .portfolio-logo { display: block; text-align: left; min-height: 0; }
  .portfolio-logo:hover, .portfolio-logo:focus-visible { transform: none; }
  .portfolio-logo .portfolio-logo__mark {
    width: 100%;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #f7f5f2;
  }
  .portfolio-logo .portfolio-logo__mark img,
  .portfolio-logo .portfolio-logo__mark video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
    filter: none;
    transition: transform 400ms ease;
  }
  .portfolio-logo:hover .portfolio-logo__mark > * { transform: scale(1.025); }
  .portfolio-logo--dyson:hover .portfolio-logo__mark > * {
    transform: none;
  }
  .project-card-caption { display: flex; flex-direction: column; gap: .3rem; margin-top: 1rem; }
  .project-card-caption > span:first-child { font-size: 1.35em; }
  .project-card-caption > span:last-child { color: #777; font-size: .9em; }
  @media (max-width: 767px) {
    .portfolio-logo-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
