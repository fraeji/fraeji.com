---
import { getCollection, getEntry, render } from 'astro:content';
import otriumFestive from '../assets/projects/otrium/festive-4.jpg';
import otriumLookbook from '../assets/projects/otrium/otrium-you-7.jpg';
import romeBust from '../../public/images/citizenm/rome/towel.webp';
import nrCover from '../../public/images/nr-magazine/02-NR17-Cover-VTSS-shot-by-Erika-Kamano-min-scaled.jpg';
import dysonSummer from '../../public/images/dyson-british-summer-hero.jpg';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FlyingPhotos from '../components/FlyingPhotos.astro';
import { getEssays } from '../lib/essays';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/home.md');
const { Content: Intro } = await render(home);
const { likes } = home.data;

const essays = (await getEssays())
  .filter((essay) => essay.id !== 'gardening-1-your-unemployed-friend')
  .sort((a, b) => a.data.order - b.data.order);
const homepageWork = [
  ['vio', '/videos/vio/logo-animation.mp4', 'Vio logo animation'],
  ['nr-magazine', nrCover, 'NR Magazine issue 17 cover featuring VTSS'],
  ['citizenm', romeBust, 'Marble bust wrapped in a towel'],
  ['otrium', otriumFestive, 'Two models in pink from Otrium’s festive campaign'],
  ['dyson', '/videos/dyson/dyson-journeys-of-time.mp4', 'Dyson Women of Firsts campaign film'],
  ['otrium', otriumLookbook, 'Model in sunglasses by a reflective shop window, photographed by Winter van den Brink'],
  ['dyson', '/videos/dyson/linkedin-7270394155296559105.mp4', 'Dyson 360 Vis Nav faux out-of-home campaign'],
  ['dyson', dysonSummer, 'Dyson Built for British Summer campaign posters'],
] as const;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <SiteHeader />

  <div class="home-columns grid grid-cols-4 gap-x-12 max-md:grid-cols-1 max-md:gap-y-40">
    <section>
      <h2 class="label">Nice to meet you</h2>
      <div class="copy mt-[0.75em]">
        <Intro />
      </div>
      <p class="mt-[0.75em]">Get in touch | <a href="mailto:fpierce7@gmail.com">Email</a> | <a href="https://twitter.com/fraeji">@fraeji</a></p>
    </section>

    <section>
      <h2 class="label"><a class="project-preview-link" href="/portfolio">Recent work
        <span class="project-hover-preview" aria-hidden="true">
          <video src="/videos/portfolio-montage.mp4" autoplay loop muted playsinline preload="metadata"></video>
          <span>Selected work</span>
        </span>
      </a></h2>
      <ul class="mt-[0.75em]">
        {projects.map((project) => (
          <li><a class="project-preview-link" href={`/portfolio/${project.id}/`}>
            {project.data.title}
            <span class="project-hover-preview" aria-hidden="true">
              {project.id === 'vio' ? (
                <video class="vio-logo-preview" src="/videos/vio/logo-animation.mp4" autoplay loop muted playsinline preload="metadata"></video>
              ) : project.id === 'citizenm' ? (
                <img src="/images/citizenm/november-sale-hero.jpg" alt="" />
              ) : project.id === 'dyson' ? (
                <img class="dyson-summer-preview" src="/images/dyson-british-summer-hero.jpg" alt="" />
              ) : project.id === 'otrium' ? (
                <Image src={project.data.cover} alt="" width={840} height={473} fit="cover" />
              ) : project.id === 'nr-magazine' ? (
                <img class="nr-cover-preview" src="/images/nr-magazine/02-NR17-Cover-VTSS-shot-by-Erika-Kamano-min-scaled.jpg" alt="" width="840" height="473" />
              ) : (
                <Image src={project.data.cover} alt="" width={840} />
              )}
              <span class="preview-role">{project.data.role}<br />{project.data.year}</span>
            </span>
          </a></li>
        ))}
      </ul>
    </section>
    <section>
      <h2 id="writing" class="label">Writing</h2>
      <ul class="mt-[0.75em]">
        {
          essays.map((essay) => (
            <li>
              <a href={`/${essay.id}`}>{essay.data.title}</a>
            </li>
          ))
        }
        <li><a href="https://fraeji.substack.com/">Substack</a> | Follow me</li>
      </ul>
    </section>

    <section>
      <h2 class="label">What I like</h2>
      <ul class="mt-[0.75em]">
        {likes.map((like) => <li>{like}</li>)}
      </ul>
    </section>
  </div>

  <section class="homepage-work" id="homepage-work-heading" aria-label="Recent work gallery">
    <div class="homepage-work__grid">
      {homepageWork.map(([project, image, alt]) => (
        <a href={`/portfolio/${project}/`} aria-label={alt}>
          {typeof image === 'string' ? (
            <video class:list={[{ 'homepage-work__logo': project === 'vio' }]} src={image} autoplay loop muted playsinline preload="metadata" aria-hidden="true"></video>
          ) : (
            <Image src={image} alt={alt} widths={[320, 640]} sizes="(max-width: 768px) 50vw, 25vw" loading="lazy" />
          )}
        </a>
      ))}
    </div>
  </section>

  <FlyingPhotos />
</Base>

<style>
  .homepage-work { margin-top: clamp(2.75rem, 3vw, 4rem); }
  .homepage-work__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .homepage-work__grid img, .homepage-work__grid video { display: block; width: 100%; aspect-ratio: 5 / 4; object-fit: cover; }
  .homepage-work__grid .homepage-work__logo { object-fit: contain; background: #f7f5f2; }
  @media (max-width: 768px) {
    .homepage-work__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  }

  @media (min-width: 769px) { .home-columns { grid-template-columns: 1fr .65fr 1.2fr 1fr; } }
  .project-preview-link { position: relative; display: inline-block; }
  .project-hover-preview { position: fixed; top: 25vh; left: 42vw; width: min(45vw, 40rem); background: transparent; padding: 0; z-index: 100; pointer-events: none; opacity: 0; visibility: hidden; transform: translateY(.5rem); transition: opacity .18s, transform .18s, visibility .18s; }
  .project-hover-preview img { width: 100%; height: auto; max-height: 26rem; object-fit: contain; }
  .project-hover-preview video { display: block; width: 100%; height: auto; max-height: 26rem; object-fit: contain; }
  .project-hover-preview img.dyson-summer-preview { display: block; aspect-ratio: 16 / 9; max-height: none; object-fit: cover; }
  .project-hover-preview img.nr-cover-preview { aspect-ratio: 16 / 9; object-fit: cover; object-position: center 35%; }
  .project-hover-preview video.vio-logo-preview { aspect-ratio: 16 / 9; object-fit: cover; }
  .project-hover-preview > span { display: block; position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem 1rem 1rem; color: white; background: linear-gradient(transparent, #0009); font-size: 1rem; line-height: 1.4; text-align: left; }
  @media (hover: hover) {
    .project-preview-link:hover .project-hover-preview,
    .project-preview-link:focus-visible .project-hover-preview { opacity: 1; visibility: visible; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) { .project-hover-preview { transition: none; } }
</style>
