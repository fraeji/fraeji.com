---
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/home.md');
const { name, email, links, handle } = home.data;
---

<footer class="site-footer mt-[calc(var(--body-size)*4.5)] pt-[1.5em]">
  <div class="footer-content">
  <p class="text-muted">© {name} / {new Date().getFullYear()}</p>
  <nav aria-label="Footer navigation">
    <p class="text-muted">Site</p>
    <a href="/">Home</a>
    <a href="/#writing">Writing</a>
    <a href="/portfolio/">Recent work</a>
  </nav>
  <nav aria-label="Contact and social links">
    <p class="text-muted">Elsewhere</p>
    <a href={`mailto:${email}`}>Get in touch</a>
    <span>Subscribe to my <a href="https://fraeji.substack.com/">Substack</a></span>
    {links.map((link) => <a href={link.url} target="_blank" rel="noopener">{link.label}</a>)}
    <span><a href={handle.url} target="_blank" rel="noopener">{handle.label}</a> everywhere.</span>
  </nav>
  </div>
</footer>

<style>
  .site-footer {
    font-size: 0.8em;
  }
  .footer-content { display: grid; grid-template-columns: 1fr max-content max-content; gap: 1.5rem 3rem; }
  .footer-content > p { margin: 0; }
  nav { display: flex; flex-direction: column; align-items: flex-start; text-align: left; gap: .35em; }
  nav p { margin: 0; }
  @media (max-width: 600px) { .footer-content { grid-template-columns: 1fr 1fr; column-gap: 2rem; } .footer-content > p { grid-column: 1 / -1; } }
</style>
