---
import { getEntry } from 'astro:content';

const home = await getEntry('home', 'home');
if (!home) throw new Error('Missing src/content/home.md');
const { name, email, substack, links, handle } = home.data;

// Quick links to the main pages.
const pages = [
  { label: 'Home', href: '/' },
  { label: 'Writing', href: '/#writing' },
  { label: 'Portfolio', href: '/portfolio' },
];
---

<footer class="site-footer mt-[calc(var(--body-size)*4.5)] border-t border-rule pt-[1.5em]">
  <div class="grid grid-cols-12 gap-x-12 max-md:grid-cols-2 max-md:gap-y-[2em]">
    <div class="col-span-4 max-md:col-span-2">
      <p class="italic">Copywriter and creative based in Amsterdam.</p>
      <p class="mt-[1em]">Amsterdam<span data-clock></span></p>
      <p class="mt-[1em]"><a href={`mailto:${email}`}>Get in touch</a></p>
    </div>

    <nav class="col-span-2 max-md:col-span-1" aria-label="Index">
      <h2 class="text-muted">Index</h2>
      <ul>
        {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
      </ul>
    </nav>

    <nav class="col-span-2 max-md:col-span-1" aria-label="Elsewhere">
      <h2 class="text-muted">Elsewhere</h2>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener">{link.label}</a>
            </li>
          ))
        }
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li><a href={handle.url} target="_blank" rel="noopener">{handle.label}</a> everywhere</li>
      </ul>
    </nav>

    {
      substack && (
        // Opens Substack's own sign-up page with the email already filled in.
        <form action={new URL('/subscribe', substack).href} method="get" target="_blank" class="subscribe col-span-4 max-md:col-span-2">
          <label for="footer-email" class="text-muted">New writing by email, via Substack</label>
          <div class="mt-[0.25em] flex items-baseline gap-x-[1em]">
            <input id="footer-email" type="email" name="email" required placeholder="Your email" autocomplete="email" />
            <button type="submit">Subscribe</button>
          </div>
        </form>
      )
    }
  </div>

  <p class="mt-[3em] text-muted">©{name} / {new Date().getFullYear()}</p>
</footer>

<style>
  .site-footer {
    font-size: 0.8em;
  }

  .site-footer h2 {
    font-size: 1em;
    font-weight: 400;
  }

  .subscribe label {
    display: block;
  }

  .subscribe input {
    flex: 1;
    min-width: 0;
    padding: 0.15em 0;
    border: 0;
    border-bottom: 1px solid var(--color-rule);
    background: none;
    font: inherit;
    color: inherit;
    outline: none;
  }

  .subscribe input:focus {
    border-bottom-color: var(--color-pink);
  }

  .subscribe input::placeholder {
    color: var(--color-muted);
  }

  /* Looks like the rest of the links. */
  .subscribe button {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--color-pink);
    text-decoration: underline;
    cursor: pointer;
  }

  .subscribe button:hover,
  .subscribe button:focus-visible {
    text-decoration: none;
  }
</style>

<script>
  // Freya's local time, ticking over each minute.
  const format = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/Amsterdam',
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });

  const tick = () => {
    for (const clock of document.querySelectorAll('[data-clock]')) {
      clock.textContent = `, ${format.format(new Date())}`;
    }
  };

  tick();
  setInterval(tick, 15_000);
</script>
